<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        get-aws-credentials
        Returns (as payload) a map: { accessKeyId, secretAccessKey, sessionToken, expiresAt }
        Served from the object store while valid for at least another 5 minutes, otherwise
        refreshed through exchange-oidc-for-aws-creds.
    -->
    <sub-flow name="get-aws-credentials">
        <os:retrieve key="awsCreds" objectStore="awsCredsStore" target="cachedCreds">
            <os:default-value>#[null]</os:default-value>
        </os:retrieve>
        <choice>
            <when expression="#[vars.cachedCreds != null and (vars.cachedCreds.expiresAt as DateTime) &gt; (now() + |PT5M|)]">
                <set-payload value="#[vars.cachedCreds]"/>
            </when>
            <otherwise>
                <flow-ref name="exchange-oidc-for-aws-creds"/>
            </otherwise>
        </choice>
    </sub-flow>

    <!--
        exchange-oidc-for-aws-creds
        1. client_credentials grant against Entra ID -> JWT
        2. AssumeRoleWithWebIdentity(JWT) against STS  -> temporary credentials
        3. cache them
    -->
    <sub-flow name="exchange-oidc-for-aws-creds">
        <!-- 1. OIDC token from Entra ID (v2.0 endpoint) -->
        <http:request method="POST" config-ref="Entra_HTTP_Request_config"
                      path="#['/' ++ p('entra.tenantId') ++ '/oauth2/v2.0/token']">
            <http:body><![CDATA[#[output application/x-www-form-urlencoded --- {
                grant_type: "client_credentials",
                client_id: p('entra.clientId'),
                client_secret: p('entra.clientSecret'),
                scope: "api://" ++ p('entra.clientId') ++ "/.default"
            }]]]></http:body>
        </http:request>
        <set-variable variableName="idToken" value="#[payload.access_token]"/>

        <!-- 2. Swap the JWT for temporary AWS credentials -->
        <http:request method="POST" config-ref="STS_HTTP_Request_config" path="/">
            <http:body><![CDATA[#[output application/x-www-form-urlencoded --- {
                Action: "AssumeRoleWithWebIdentity",
                Version: "2011-06-15",
                RoleArn: p('aws.roleArn'),
                RoleSessionName: "mule-" ++ uuid(),
                WebIdentityToken: vars.idToken,
                DurationSeconds: p('aws.sessionDurationSeconds')
            }]]]></http:body>
        </http:request>

        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/java
ns sts https://sts.amazonaws.com/doc/2011-06-15/
var c = payload.sts#AssumeRoleWithWebIdentityResponse.sts#AssumeRoleWithWebIdentityResult.sts#Credentials
---
{
    accessKeyId:     c.sts#AccessKeyId as String,
    secretAccessKey: c.sts#SecretAccessKey as String,
    sessionToken:    c.sts#SessionToken as String,
    expiresAt:       c.sts#Expiration as String
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <!-- do not keep the JWT around any longer than needed -->
                <ee:set-variable variableName="idToken"><![CDATA[%dw 2.0
output application/java
---
null]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- 3. cache (payload is left untouched by os:store) -->
        <os:store key="awsCreds" objectStore="awsCredsStore"/>
        <logger level="INFO" category="com.acme.s3oidc.credentials"
                message="#['Obtained temporary AWS credentials, valid until ' ++ payload.expiresAt]"/>
    </sub-flow>
</mule>
