<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!-- Select the environment with -Dmule.env=prod (defaults to dev) -->
    <global-property name="mule.env" value="dev"/>
    <configuration-properties file="config-${mule.env}.yaml"/>

    <!-- Inbound API (what your consumers call) -->
    <http:listener-config name="HTTP_Listener_config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!-- 1. Identity provider: Microsoft Entra ID token endpoint -->
    <http:request-config name="Entra_HTTP_Request_config" responseTimeout="30000">
        <http:request-connection protocol="HTTPS" host="${entra.host}" port="443"/>
    </http:request-config>

    <!-- 2. AWS STS (regional endpoint). AssumeRoleWithWebIdentity is NOT signed. -->
    <http:request-config name="STS_HTTP_Request_config" responseTimeout="30000">
        <http:request-connection protocol="HTTPS" host="sts.${aws.region}.amazonaws.com" port="443"/>
    </http:request-config>

    <!-- 3. Cloudflare, which fronts S3. Requests here are SigV4-signed with the temporary credentials. -->
    <http:request-config name="Cloudflare_HTTP_Request_config" responseTimeout="60000">
        <http:request-connection protocol="${cloudflare.protocol}" host="${cloudflare.host}" port="${cloudflare.port}"/>
    </http:request-config>

    <!-- Temporary AWS credentials cache. TTL is shorter than the 1h STS session so we never
         hand out credentials that are about to expire. In-memory: each CloudHub replica /
         node keeps its own copy, which is fine (one STS call per replica per ~55 min). -->
    <os:object-store name="awsCredsStore" persistent="false" maxEntries="10"
                     entryTtl="55" entryTtlUnit="MINUTES"/>
</mule>
